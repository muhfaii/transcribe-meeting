{
  "name": "transcribe-meeting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build && wrangler dev --var REQUIRE_ACCESS:0",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && vite build && wrangler deploy --dry-run --outdir dist/worker-dry"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "docx": "^9.16.0",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "jszip": "^3.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
