{
  "name": "transcribe-meeting",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "dist/web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "transcribe-meeting",
      "database_id": "REPLACE_WITH_YOUR_D1_ID"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "transcribe-meeting-media" }
  ],
  "vars": {
    "R2_BUCKET": "transcribe-meeting-media",
    "MAX_UPLOAD_BYTES": "1073741824",
    "QWEN_BASE_URL": "https://ap-southeast-1.maas.qwencloudapi.com",
    "QWEN_ASR_MODEL": "qwen-audio-3.1-asr-flash-filetrans",
    // Fail-closed: the API refuses requests without a valid Cloudflare Access login.
    // Also set ACCESS_TEAM_DOMAIN and ACCESS_AUD (see DEPLOY.md). Local dev passes --var REQUIRE_ACCESS:0.
    "REQUIRE_ACCESS": "1",
    // Spend guard: at most this many new recordings per rolling 24 hours.
    "MAX_JOBS_PER_DAY": "30"
  },
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/2 * * * *"] }
}
